{
  "name": "@servicehub/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.js",
    "seed": "node --env-file-if-exists=../../.env src/seed.js",
    "test": "NODE_ENV=test node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@servicehub/shared": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": { "supertest": "^7.0.0", "vitest": "^2.1.0" }
}
