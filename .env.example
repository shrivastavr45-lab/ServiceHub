# ---- API ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://servicehub:servicehub@localhost:5432/servicehub
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:4000
BCRYPT_ROUNDS=10
# Seed data passwords (dev only)
SEED_PASSWORD=Password123!
# ---- Web (Vite) ----
VITE_API_URL=http://localhost:4000
# Used by `npm test` (a separate database that is wiped on every test run!)
TEST_DATABASE_URL=postgres://servicehub:servicehub@localhost:5432/servicehub_test
